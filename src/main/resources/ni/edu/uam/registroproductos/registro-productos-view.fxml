<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="604.0" prefWidth="722.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registroproductos.controller.ProductoController">
   <children>
      <Label layoutX="268.0" layoutY="25.0" text="Registro de productos">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <GridPane layoutX="27.0" layoutY="79.0" prefHeight="116.0" prefWidth="329.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="177.0" minWidth="10.0" prefWidth="102.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="251.0" minWidth="10.0" prefWidth="227.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nombre:" />
            <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1" />
            <Label text="Categoría:" GridPane.rowIndex="1" />
            <TextField fx:id="txtCategoria" promptText="Categoría" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Precio:" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Fecha de ingreso:" GridPane.rowIndex="3" />
            <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox layoutX="128.0" layoutY="204.0" prefHeight="41.0" prefWidth="200.0" spacing="8.0">
         <children>
            <Button fx:id="btnAgregar" mnemonicParsing="false" text="Agregar" />
            <Button fx:id="btnActualizar" mnemonicParsing="false" text="Actualizar" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" text="Limpiar" />
         </children>
      </HBox>
      <Label layoutX="373.0" layoutY="79.0" text="Imagen del producto:" />
      <Button fx:id="btnImagen" layoutX="380.0" layoutY="254.0" mnemonicParsing="false" text="Seleccionar imagen" />
      <ImageView fx:id="ivImagen" fitHeight="150.0" fitWidth="329.0" layoutX="372.0" layoutY="102.0" pickOnBounds="true" preserveRatio="true" />
      <Separator layoutX="20.0" layoutY="297.0" prefHeight="17.0" prefWidth="684.0" />
      <Label layoutX="20.0" layoutY="321.0" text="Productos registrados">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TableView fx:id="tvRegistros" layoutX="20.0" layoutY="353.0" prefHeight="232.0" prefWidth="684.0">
        <columns>
          <TableColumn fx:id="colID" prefWidth="65.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="165.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="177.0" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="92.0" text="Precio" />
            <TableColumn prefWidth="149.0" text="Fecha de ingreso" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
